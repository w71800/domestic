# 本機瀏覽器開發（不走 LINE）
NEXT_PUBLIC_DEV_MOCK_AUTH=true
DEV_MOCK_LINE_USER_ID=U-dev-local

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 手動觸發提醒 API 用。內部排程（Zeabur 常駐行程）不走這個 secret。
CRON_SECRET=change-me

# 正式環境預設會在行程內每天 09:00（台北）跑提醒。
# 本機若要啟用：ENABLE_INTERNAL_CRON=true
# 正式環境若要關掉：DISABLE_INTERNAL_CRON=true
# ENABLE_INTERNAL_CRON=
# DISABLE_INTERNAL_CRON=

# LINE（接上 LIFF 後關掉 NEXT_PUBLIC_DEV_MOCK_AUTH）
# NEXT_PUBLIC_* 在 Zeabur 必須於「建置前」就設好
# LINE LIFF 相關設定（持有 LIFF 的 Channel ID）
NEXT_PUBLIC_LIFF_ID=
LINE_CHANNEL_ID=

# LINE OA 相關設定
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
